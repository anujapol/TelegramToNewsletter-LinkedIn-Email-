# Telegram API credentials - https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_string_here
TELEGRAM_PHONE=+1XXXXXXXXXX

# Telegram session string (generated once via bootstrap script)
TELEGRAM_SESSION_STRING=

# Group name (must match exactly as shown in Telegram)
GROUP_NAME=Your Group Name Here

# Google Sheets ID from URL between /d/ and /edit
GOOGLE_SHEET_ID=your_sheet_id_here

# Anthropic API - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Email and contact
GMAIL_RECIPIENT=your-email@example.com
CONTACT_FOR_GROUP_ACCESS=Group Admin on Telegram
